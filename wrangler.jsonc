{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luv4u",
  "main": "server/worker.mjs",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luv4u",
      "database_id": "luv4u-d1-placeholder"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "luv4u-media"
    }
  ]
}
