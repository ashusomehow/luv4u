# Supabase project (Project Settings → API). Server-side only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for gift photos, voice notes, music and share covers (created by the migration).
SUPABASE_STORAGE_BUCKET=gift-media

# Random string used to hash edit keys and visitor tokens. Generate with: openssl rand -hex 32
# Changing it later invalidates every existing edit key, so set it once.
RATE_SALT=

# Canonical public origin, used for sitemap, canonical URLs and share images.
# Production: https://kholona.in (no trailing slash). For local development use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://kholona.in

# Vercel Cron sends this as a Bearer token to /api/cron/cleanup.
CRON_SECRET=

# Payment is ALWAYS required: a new gift is a private preview until it is paid for. There is no switch for that.
# Optional: change the one-time price, in whole rupees (default 199). Leave empty to charge 199.
PAYMENT_PRICE_INR=
# How many days an unpaid preview is kept before the daily cleanup removes it (1-30, default 7).
PREVIEW_TTL_DAYS=

# Razorpay (Dashboard -> Account & Settings -> API keys). Server-side only: never prefix with NEXT_PUBLIC_.
# Use rzp_test_ keys until the account is activated; nothing charged with them moves real money. See docs/PAYMENTS.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# You choose this when you add the webhook (Dashboard -> Account & Settings -> Webhooks). Any long random string.
RAZORPAY_WEBHOOK_SECRET=

# Local development and Vercel Preview only: with no Razorpay keys, the Unlock button unlocks without charging.
# Ignored on the Vercel Production deployment, and ignored whenever Razorpay keys are set. Never needed in production.
PAYMENT_SIMULATE=false

# Meta (Facebook / Instagram) ad tracking: leave all empty to switch it off. See docs/META-ADS.md.
# Pixel id (Events Manager -> your Pixel -> Settings). Public by design: it is part of the Pixel code on the page.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token (Events Manager -> Settings -> Conversions API -> Generate access token). Server-side only.
META_CAPI_TOKEN=
# Only while checking: the code from Events Manager -> Test events. Remove it before running ads.
META_TEST_EVENT_CODE=

# Safety: admin access for reviewing reports and removing gifts (see docs/OPERATIONS.md).
# At least 24 random characters. Leave unset to keep the admin endpoints switched off.
ADMIN_TOKEN=

# Shown on the Terms, Privacy, Refund and Contact pages. Fill these in before launch.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER=

# After kholona.in is live: set this to the old Vercel hostname (for example luv4u-tau.vercel.app) and every
# page there redirects permanently to the same page on NEXT_PUBLIC_SITE_URL. Leave empty until the domain works.
LEGACY_HOST=
