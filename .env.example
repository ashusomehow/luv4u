# Supabase project (Project Settings → API). Server-side only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for gift photos, voice notes, music and share covers (created by the migration).
SUPABASE_STORAGE_BUCKET=gift-media

# Random string used to hash edit keys and visitor tokens. Generate with: openssl rand -hex 32
# Changing it later invalidates every existing edit key, so set it once.
RATE_SALT=

# Canonical public origin, used for sitemap, canonical URLs and share images.
# Production: https://kholona.in (no trailing slash). For local development use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://kholona.in

# Vercel Cron sends this as a Bearer token to /api/cron/cleanup.
CRON_SECRET=

# Preview first, pay after. Leave unset (or anything but "true") to keep every new gift free and
# instantly shareable. Set to "true" to make new gifts private previews until they are unlocked.
# Apply supabase/migrations/0003_gift_status.sql BEFORE turning this on.
PAYMENTS_REQUIRED=
# One-time price shown to buyers, whole rupees (default 99). Only used when PAYMENTS_REQUIRED=true.
PAYMENT_PRICE_INR=
# How many days an unlocked-never preview is kept before the daily cleanup removes it (1-30, default 7).
PREVIEW_TTL_DAYS=

# Try the whole unlock flow without a payment provider: the Pay button unlocks the gift and charges nothing.
# Ignored on the Vercel Production deployment. Remove before real payments go live.
PAYMENT_SIMULATE=false

# Safety: admin access for reviewing reports and removing gifts (see docs/OPERATIONS.md).
# At least 24 random characters. Leave unset to keep the admin endpoints switched off.
ADMIN_TOKEN=

# Shown on the Terms, Privacy, Refund and Contact pages. Fill these in before launch.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER=

# After kholona.in is live: set this to the old Vercel hostname (for example luv4u-tau.vercel.app) and every
# page there redirects permanently to the same page on NEXT_PUBLIC_SITE_URL. Leave empty until the domain works.
LEGACY_HOST=
