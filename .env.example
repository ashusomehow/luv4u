# Supabase project (Project Settings → API). Server-side only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for gift photos, voice notes, music and share covers (created by the migration).
SUPABASE_STORAGE_BUCKET=gift-media

# Random string used to hash edit keys and visitor tokens. Generate with: openssl rand -hex 32
# Changing it later invalidates every existing edit key, so set it once.
RATE_SALT=

# Canonical public origin, used for sitemap, canonical URLs and share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron sends this as a Bearer token to /api/cron/cleanup.
CRON_SECRET=

# Preview first, pay after. Leave unset (or anything but "true") to keep every new gift free and
# instantly shareable. Set to "true" to make new gifts private previews until they are unlocked.
# Apply supabase/migrations/0003_gift_status.sql BEFORE turning this on.
PAYMENTS_REQUIRED=
# How many days an unlocked-never preview is kept before the daily cleanup removes it (1-30, default 7).
PREVIEW_TTL_DAYS=
